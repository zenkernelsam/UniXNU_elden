--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -283,6 +283,9 @@
 _cnputs(char *c, int size, bool poll)
 {
 	if (disableConsoleOutput) {
+		/* Releasing GOP text must not silence the independent USB ring. */
+		if (c && elden_usb_log_putc)
+			while (size-- > 0) elden_usb_log_putc(*c++);
 		return;
 	}
 
@@ -529,6 +532,8 @@
 console_write(char *str, int size)
 {
 	if (disableConsoleOutput) {
+		if (str && elden_usb_log_putc)
+			while (size-- > 0) elden_usb_log_putc(*str++);
 		return;
 	}
 
@@ -614,6 +619,7 @@
 console_write_unbuffered(char c)
 {
 	if (disableConsoleOutput) {
+		if (elden_usb_log_putc) elden_usb_log_putc(c);
 		return;
 	}
 
