+	zone_id_require_aligned(zone_index(zone), backing);
+	native_zone_pgz_probe_stage = 1;
+	native_zone_pgz_probe_backing = (uintptr_t)backing;
+	*(volatile uint64_t *)backing = 0x50475a344b50524fULL;
+	vm_offset_t alias = pgz_protect(zone, (vm_offset_t)backing, __builtin_frame_address(0));
+	if (alias == (vm_offset_t)backing || *(volatile uint64_t *)alias != *(volatile uint64_t *)backing) {
+		panic("offline PGZ fixture did not protect actual backing");
+	}
+	native_zone_pgz_probe_alias = alias;
+	native_zone_pgz_probe_metadata = zone_meta_from_addr(alias)->zm_bits;
+	native_zone_pgz_probe_stage = 2;
+	zone_id_t expected = zone_index(zone);
+	vm_offset_t argument = alias;
+	if (mode == 2) argument++;
+	if (mode == 3) {
+		other = zone_create("native.pgz.other", 192, ZC_NOPGZ | ZC_DESTRUCTIBLE);
+		expected = zone_index(other);
+	}
+	if (mode == 4) {
+		if (pgz_unprotect(alias, __builtin_frame_address(0)) != (vm_offset_t)backing) panic("offline PGZ fixture backing changed");
+		zfree(zone, objects[count - 1]);
+		objects[count - 1] = NULL;
+		native_zone_pgz_probe_stage = 3;
+	}
+	native_zone_pgz_probe_expected_zone = expected;
+	native_zone_pgz_probe_argument = argument;
+	zone_id_require_aligned(expected, (void *)argument);
+	if (mode != 1) panic("offline PGZ negative case unexpectedly returned");
+	*(volatile uint64_t *)alias ^= 1;
+	if (*(volatile uint64_t *)backing != 0x50475a344b50524eULL ||
+	    pgz_unprotect(alias, __builtin_frame_address(0)) != (vm_offset_t)backing) {
+		panic("offline PGZ backing identity or write failed");
+	}
+	for (unsigned i = 0; i < count; i++) zfree(zone, objects[i]);
+	if (other) zdestroy(other);
+	zdestroy(zone);
+	native_zone_pgz_probe_stage = 4;
+	native_zone_pgz_probe_checkpoint();
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, native_zone_pgz_alignment_probe);
+#endif
