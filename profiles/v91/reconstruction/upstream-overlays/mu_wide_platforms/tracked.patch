diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
index 76dcb4f9..6285be14 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -12,8 +12,12 @@ _StackBase:
 	.quad UEFI_BASE
 
 _StackSize:
-	/* Image Size */
-	.quad UEFI_SIZE
+	/* Image Size: firmware plus embedded FAT payload when present */
+#ifdef EMBEDDED_PAYLOAD_SIZE
+	.quad	UEFI_SIZE + (EMBEDDED_PAYLOAD_SIZE)
+#else
+	.quad	UEFI_SIZE
+#endif
 
 	/* Flags */
 	.quad 0
@@ -38,7 +42,11 @@ _Start:
 	ldr		x5, _StackBase
 	cmp		x4, x5
 	beq		_Entry
+#ifdef EMBEDDED_PAYLOAD_SIZE
+	ldr		x6,  _CopySize
+#else
 	ldr		x6,  _StackSize
+#endif
 
 _CopyLoop:
 	ldp		x2, x3, [x4], #16
@@ -48,12 +56,24 @@ _CopyLoop:
 	ldr		x5, _StackBase
 
 _Entry:
+#ifdef EMBEDDED_PAYLOAD_SIZE
+	/* x1 still holds the decompressed image base; the payload follows the FD. */
+	add		x2, x1, #UEFI_SIZE
+	ldr		x3, =EMBEDDED_PAYLOAD_SIZE
+#endif
 	br		x5
 
 _Dead:
 	/* We should never get here */
 	b		_Dead
 
+#ifdef EMBEDDED_PAYLOAD_SIZE
+.align 3
+_CopySize:
+	/* Only the firmware volume is copied; the payload stays in place. */
+	.quad	UEFI_SIZE
+#endif
+
 .text
 .align 4
 
